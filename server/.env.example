# Replace both values with unique random secrets. Never commit a populated .env file.
MOLIDO_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# URL-safe Base64 encoding of exactly 32 cryptographically random bytes
MOLIDO_DATA_KEY=REPLACE_WITH_BASE64URL_32_BYTE_KEY
# Optional: token lifetime and abuse-limit tuning (defaults shown)
# MOLIDO_TOKEN_TTL_SECONDS=1209600
# MOLIDO_MAX_LOGIN_FAILURES=5
# MOLIDO_LOGIN_LOCKOUT_SECONDS=900
# MOLIDO_AUTH_RATE_LIMIT=60
# MOLIDO_LOGIN_RATE_LIMIT=20
# MOLIDO_AUTH_RATE_WINDOW_SECONDS=60
# MOLIDO_TRUST_PROXY_HEADERS=0
# MOLIDO_MAX_REQUEST_BYTES=1048576
# Optional: admin API and metrics bearer token
# MOLIDO_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# MOLIDO_METRICS_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
