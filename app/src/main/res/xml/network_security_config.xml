<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds trust only the platform system store and never cleartext HTTP.
  Debug builds additionally accept a user-installed CA so a self-hosted LAN
  server behind a private CA (see docs/LAN_DEPLOYMENT_AND_RECOVERY.md) can be
  tested without breaking production trust. debug-overrides is ignored in
  release builds, so shipping a private CA in the APK is never required.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
