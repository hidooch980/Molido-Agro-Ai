# Copy to .env (never commit .env) and replace every value.
# Generate the two secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
MOLIDO_HTTP_PORT=8080
# Signs bearer tokens; at least 32 characters. Rotating it logs every device out.
MOLIDO_JWT_SECRET=
# 32 raw bytes, base64url, no padding. Encrypts queued payloads at rest; losing it loses them.
MOLIDO_DATA_KEY=
# 1 lets anyone who reaches the service register as OWNER (fine for a LAN install).
# Set to 0 on anything reachable from the internet and create accounts with the admin API.
MOLIDO_ALLOW_REGISTRATION=1
# Enables the account-admin API (POST /v1/admin/users); empty disables it.
MOLIDO_ADMIN_TOKEN=
# Enables GET /metrics; empty disables it.
MOLIDO_METRICS_TOKEN=
# Optional: ChirpStack MQTT ingest for real LoRa sensors.
MOLIDO_CHIRPSTACK_INGEST_URL=
MOLIDO_CHIRPSTACK_INGEST_SECRET=
# Set to 1 only when a reverse proxy terminates TLS in front of this container.
MOLIDO_TRUST_PROXY_HEADERS=0
# Automatic copies of the database; interval 0 disables them. compose mounts /backups as a volume.
MOLIDO_BACKUP_DIR=/backups
MOLIDO_BACKUP_INTERVAL_SECONDS=86400
MOLIDO_BACKUP_KEEP=14
# Optional 32-byte base64url key: when set, every copy is written as an AES-GCM envelope
# (molido-*.sqlite3.enc) instead of a readable database. A copy holds usernames and hashes.
MOLIDO_BACKUP_KEY=
